# Kopieren nach local.properties (wird nicht committed) und Werte anpassen.

sdk.dir=/pfad/zum/Android/Sdk

# Backend-URL mit trailing slash.
# Emulator -> Host-Loopback:  http://10.0.2.2:8000/
# Echtes Geraet im selben WLAN wie das Backend -> LAN-IP des Rechners/Pi:
koe.baseUrl=http://192.168.178.37:8000/

# Muss zu API_TOKEN in backend/.env passen.
koe.apiToken=
