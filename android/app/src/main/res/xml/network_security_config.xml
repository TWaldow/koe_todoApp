<?xml version="1.0" encoding="utf-8"?>
<!-- Erlaubt Klartext-HTTP nur zur lokalen Backend-Adresse im Heimnetz, nicht global. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.178.201</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
